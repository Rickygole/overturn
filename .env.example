# Copy to .env and fill in. Everything here has a working default except the
# project id, so the only line you must change is the first.

# --- Google Cloud placement --------------------------------------------------
OVERTURN_PROJECT_ID=your-project-id

# Infrastructure region: Cloud Run, buckets, Pub/Sub, Firestore.
OVERTURN_LOCATION=us-central1

# Where generative calls go, which is NOT the infrastructure region.
# Gemini 3.x is served only from the global endpoint; every regional endpoint
# returns 404 NOT_FOUND for gemini-3.5-flash while the Model Garden catalogue
# lists it as GA. Embeddings are the other way round — regional only.
OVERTURN_MODEL_LOCATION=global
OVERTURN_EMBEDDING_LOCATION=us-central1

# --- Modes -------------------------------------------------------------------
# local: offline backend, no network, no spend. cloud: real Vertex AI.
OVERTURN_RUNTIME_MODE=local
# auto | scripted | vertex | adk
OVERTURN_LLM_BACKEND=auto

# Persist local runs to a file so the pipeline, the CLI and the web interface
# can be separate processes looking at the same cases. Empty keeps tests hermetic.
OVERTURN_LOCAL_STATE_PATH=./local_state/store.json

# --- Optional ----------------------------------------------------------------
# Model Armor template backing Sentinel's second screening layer. Empty disables
# it, and the audit log then records the layer as skipped rather than clean.
OVERTURN_MODEL_ARMOR_TEMPLATE=

# Compress the payer response window so a multi-week lifecycle is watchable.
# Disclosed in the README and stated out loud in the demo.
OVERTURN_DEMO_TIME_ACCELERATION=false
OVERTURN_DEMO_SECONDS_PER_DAY=1.0

# Deliberate fault injection, used only to prove Verification works.
# Unset in normal operation. `first` = one bad draft then a clean retry.
# `always` = every draft bad, so the attempt cap is what stops it.
# OVERTURN_SABOTAGE_DRAFTING=first
