# Controls what `gcloud builds submit` / `gcloud run deploy --source` uploads
# as build context. Mirrors .dockerignore: the Dockerfile needs
# core/agents/services/data, the project metadata files, and the site assets
# under docs/ that the approval process serves.
#
# For more information, run: gcloud topic gcloudignore
.gcloudignore
#!include:.gitignore

.git
.venv
venv

__pycache__
*.py[cod]
.mypy_cache
.pytest_cache
.ruff_cache

tests
infra
scripts

.DS_Store
*.log
local_state/
.firestore-emulator/
dist
build
