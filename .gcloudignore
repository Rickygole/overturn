# Controls what `gcloud builds submit` / `gcloud run deploy --source` uploads
# as build context. Mirrors .dockerignore: the Dockerfile needs
# core/agents/services/data, the project metadata files, and the site assets
# under docs/ that the approval process serves.
#
# For more information, run: gcloud topic gcloudignore
.gcloudignore
#!include:.gitignore

.git
.venv
venv

__pycache__
*.py[cod]
.mypy_cache
.pytest_cache
.ruff_cache

tests
infra/*
# ...except the fleet's identity roster, which `core.registry` reads at request
# time to render /fleet. .dockerignore carries the same exception; both are
# needed, because .gcloudignore decides what reaches the Cloud Build context
# at all and .dockerignore decides what the COPY can see once it is there.
!infra/agents.env
scripts

.DS_Store
*.log
local_state/
.firestore-emulator/
dist
build
